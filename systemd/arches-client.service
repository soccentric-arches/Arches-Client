[Unit]
Description=Arches Client — gRPC daemon for IV&V hardware validation (NVIDIA Jetson)
Documentation=https://github.com/SiliconCentric/Arches-Client
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=arches
Group=arches
WorkingDirectory=/var/lib/arches
# Starts BOTH listeners:
#   - ClientService (stream path → Server, default port 50051)
#   - HalService    (SDK/E2E path,          default port 50052)
ExecStart=/usr/bin/arches-client
Restart=on-failure
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arches-client

# Hardening
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ReadWritePaths=/var/lib/arches
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target